def antigravity_rate_model(model: str) -> str:
    """The rate-table name of an Antigravity model: effort and routing variants bill as their base model."""
    if _AGY_FLASH3.match(model):
        return "gemini-3.5-flash"
    if model in _AGY_ROUTED:
        return _AGY_ROUTED[model]
    base = _AGY_VARIANT.sub("", model)
    return "gemini-3-flash-preview" if base == "gemini-3-flash" else base


def _pb(data: bytes) -> dict[int, list]:
    """The top-level fields of one protobuf message: varints as int, length-delimited fields as bytes."""
    out: dict[int, list] = {}
    off, n = 0, len(data)
    while off < n:
        tag = shift = 0
        while True:
            byte = data[off]
            off += 1
            tag |= (byte & 127) << shift
            if byte < 128:
                break
            shift += 7
        number, wire = tag >> 3, tag & 7
        if number == 0:
            raise ValueError("invalid protobuf field")
        if wire == 0:
            value = shift = 0
            while True:
                byte = data[off]
                off += 1
                value |= (byte & 127) << shift
                if byte < 128:
                    break
                shift += 7
                if shift > 63:
                    raise ValueError("invalid protobuf varint")
        elif wire == 2:
            length = shift = 0
            while True:
                byte = data[off]
                off += 1
                length |= (byte & 127) << shift
                if byte < 128:
                    break
                shift += 7
            if length > n - off:
                raise ValueError("truncated protobuf field")
            value = data[off : off + length]
            off += length
        elif wire in (1, 5):
            off += 8 if wire == 1 else 4
            if off > n:
                raise ValueError("truncated protobuf field")
            continue
        else:
            raise ValueError("unsupported protobuf wire type")
        out.setdefault(number, []).append(value)
    return out


def _pb_num(msg: dict, key: int) -> int:
    v = msg.get(key, (None,))[0]
    return v if isinstance(v, int) and v <= _PB_MAX_INT else 0


def _pb_bytes(msg: dict, key: int) -> bytes | None:
    v = msg.get(key, (None,))[0]
    return v if isinstance(v, bytes) else None


def _pb_nested(msg: dict, key: int) -> dict:
    v = _pb_bytes(msg, key)
    return {} if v is None else _pb(v)


def _pb_text(msg: dict, key: int) -> str:
    v = _pb_bytes(msg, key)
    return "" if v is None else v.decode("utf-8").strip()


def _pb_ts(msg: dict) -> int | None:
    seconds = _pb_num(msg, 1)
    return seconds * 1000 + _pb_num(msg, 2) // 1_000_000 if seconds > 0 else None


def _agy_model_name(name: str) -> str:
    """'Gemini 4 Neon (High)' -> 'gemini-4-neon-high', 'Claude 4.5 Sonnet' -> 'claude-sonnet-4-5'."""
    if not name:
        return ""
    n = re.sub(r"\s+", "-", re.sub(r"\s*\(([^)]*)\)\s*$", r"-\1", name.lower()))
    if n.startswith("claude-"):
        n = re.sub(r"^claude-(\d+(?:\.\d+)?)-(sonnet|opus|haiku)", r"claude-\2-\1", n).replace(".", "-")
    return n


def _agy_concrete(model: str) -> bool:
    return bool(_AGY_CONCRETE.match(model)) and not _AGY_FLASH3.match(model)


def _agy_remember(models: dict[int, str], model_id: int, model: str) -> None:
    held = models.get(model_id)
    if held is None:
        models[model_id] = model
    elif held != model and (not held or not model or antigravity_rate_model(held) != antigravity_rate_model(model)):
        models[model_id] = _AGY_AMBIGUOUS


def _agy_metadata(blob: object, step: bool) -> tuple[str, int, int | None, list[dict]]:
    """(model, model_id, timestamp_ms, usages) of one generation row or one step's metadata."""
    if not isinstance(blob, bytes):
        raise ValueError("invalid metadata blob")
    root = _pb(blob)
    if step:
        data = root
        model = _pb_nested(data, 24)
    else:
        inner = _pb_bytes(root, 1)
        if inner is None:
            raise ValueError("missing generation metadata")
        data = model = _pb(inner)
    usage = _pb_bytes(data, 9 if step else 4)
    usages = [] if usage is None else [_pb(usage)]
    model_id = _pb_num(model, 1 if step else 3) or (_pb_num(usages[0], 1) if usages else 0)
    for retry in data.get(28 if step else 17, ()):
        if not isinstance(retry, bytes):
            raise ValueError("invalid retry metadata")
        retry_usage = _pb_bytes(_pb(retry), 2)
        if retry_usage is not None:
            usages.append(_pb(retry_usage))
    names = [_agy_model_name(_pb_text(model, k)) for k in ((12, 8) if step else (19, 21))]
    name = next((x for x in names if _agy_concrete(x)), None)
    if name is None:
        name = next((x for x in names if x and not re.match(r"model[_-]", x)), "")
    if step:
        ts = _pb_ts(_pb_nested(data, 8)) or _pb_ts(_pb_nested(data, 1))
    else:
        ts = _pb_ts(_pb_nested(_pb_nested(data, 9), 4))
    return name, model_id, ts, usages


# Candidate layout: one usage as one database recorded it, before the cross-database merge.
# ts_ms, model, uncached, cached, cache_create, output, reasoning, model_id, model_quality, keys, ts_quality
A_TS, A_MODEL, A_UNCACHED, A_CACHED, A_CCREATE, A_OUTPUT, A_REASON, A_MID, A_MQ, A_KEYS, A_TQ = range(11)


def _agy_candidates(gens: list, steps: list, traj_ts: int | None, fallback_ts: int) -> list[tuple]:
    out: list[tuple] = []
    gen_by_idx = {idx: entry for idx, entry in gens}
    for is_step, entries in ((True, steps), (False, gens)):
        for idx, (name, entry_mid, ts, usages) in entries:
            gen = gen_by_idx.get(idx) if is_step else None
            for u in usages:
                mid = _pb_num(u, 1) or entry_mid
                # A retry can run on another model than the generation or step it belongs to.
                if name and (mid == 0 or entry_mid == mid):
                    model = name
                elif gen is not None and (mid == 0 or gen[1] == mid):
                    model = gen[0]
                else:
                    model = ""
                thinking = _pb_num(u, 9)
                output = max(_pb_num(u, 3), thinking + _pb_num(u, 10))
                uncached, cached, ccreate = _pb_num(u, 2), _pb_num(u, 5), _pb_num(u, 4)
                if uncached + cached + ccreate + output == 0:
                    continue
                keys = tuple(f"{k}:{t}" for k, t in ((k, _pb_text(u, k)) for k in (11, 12, 7)) if t)
                out.append(
                    (
                        ts or traj_ts or fallback_ts,
                        model,
                        uncached,
                        cached,
                        ccreate,
                        output,
                        min(output, thinking),
                        mid,
                        4 if _agy_concrete(model) else 1 if model else 0,
                        keys,
                        2 if ts is not None else 1 if traj_ts is not None else 0,
                    )
                )
    return out


def read_antigravity_db(path: Path, wal: bool, fallback_ts: int) -> tuple[list[tuple], dict[int, str]] | None:
    """One conversation database's usage candidates and the model names it gives for model IDs.

    None when the database cannot be read right now; it is tried again on the next scan.
    """
    # A plain read-only open of a WAL database leaves -shm and -wal files next to it. With no WAL
    # to read there is nothing a locked read would add, so open it as an immutable file instead.
    uri = path.as_uri() + ("?mode=ro" if wal else "?immutable=1")
    try:
        con = sqlite3.connect(uri, uri=True, timeout=0.1, isolation_level=None)
    except sqlite3.Error:
        return None
    try:
        con.execute("BEGIN")
        tables = {row[0] for row in con.execute("SELECT name FROM sqlite_master WHERE type = 'table'")}
        if "gen_metadata" not in tables and "steps" not in tables:
            return [], {}  # not a conversation store, e.g. conversation_summaries.db
        gens: list = []
        steps: list = []
        # A generation row holds the conversation's whole context so far, often megabytes:
        # rows are decoded one at a time and only their small usage messages are kept.
        if "gen_metadata" in tables:
            for idx, blob in con.execute("SELECT idx, data FROM gen_metadata ORDER BY idx"):
                if not isinstance(idx, int):
                    raise ValueError("invalid generation index")
                gens.append((idx, _agy_metadata(blob, False)))
        traj_ts = None
        if "trajectory_metadata_blob" in tables:
            for (blob,) in con.execute("SELECT data FROM trajectory_metadata_blob"):
                if not isinstance(blob, bytes):
                    raise ValueError("invalid trajectory metadata")
                if traj_ts is None:
                    traj_ts = _pb_ts(_pb_nested(_pb(blob), 2))
        if "steps" in tables:
            for idx, blob in con.execute("SELECT idx, metadata FROM steps WHERE metadata IS NOT NULL ORDER BY idx"):
                if not isinstance(idx, int):
                    raise ValueError("invalid step index")
                steps.append((idx, _agy_metadata(blob, True)))
        models: dict[int, str] = {}
        for _idx, (name, mid, _ts, _usages) in gens + steps:
            if mid > 0 and _agy_concrete(name):
                _agy_remember(models, mid, name)
        return _agy_candidates(gens, steps, traj_ts, fallback_ts), models
    except (sqlite3.Error, ValueError, IndexError):
        return None
    finally:
        con.close()


def merge_antigravity(files: list[tuple[str, list[tuple], dict[int, str]]]) -> list[tuple]:
    """Usage records from every database's candidates, each request counted once.

    A request shows up in a step and in its generation, and again in every copy of the
    conversation (a backup, a second profile). Candidates that share a response ID are one
    request: it takes the largest count of each token type, the best model name and the
    best timestamp any of them has.
    """
    models: dict[int, str] = {}
    for _session, _cands, file_models in files:
        for mid, name in file_models.items():
            _agy_remember(models, mid, name)

    # Per group: [session, ts, model, uncached, cached, ccreate, output, reasoning, mq, tq, parent, size, owner]
    G_SESSION, G_TS, G_MODEL, G_TOKENS, G_MQ, G_TQ, G_PARENT, G_SIZE, G_OWNER = 0, 1, 2, slice(3, 8), 8, 9, 10, 11, 12
    groups: list[list] = []
    by_key: dict[str, int] = {}

    def find(i: int) -> int:
        root = i
        while groups[root][G_PARENT] != root:
            root = groups[root][G_PARENT]
        while i != root:
            groups[i][G_PARENT], i = root, groups[i][G_PARENT]
        return root

    def merge(left: int, right: int) -> None:
        a, b = find(left), find(right)
        if a == b:
            return
        if groups[a][G_SIZE] < groups[b][G_SIZE]:
            a, b = b, a
        target, source = groups[a], groups[b]
        first = target if target[G_OWNER] < source[G_OWNER] else source
        if source[G_MQ] == target[G_MQ]:
            best_model = first
        else:
            best_model = source if source[G_MQ] > target[G_MQ] else target
        better_time = source[G_TQ] > target[G_TQ] or (source[G_TQ] == target[G_TQ] and source[G_TS] < target[G_TS])
        best_time = source if better_time else target
        target[:] = [
            first[G_SESSION],
            best_time[G_TS],
            best_model[G_MODEL],
            *(max(x, y) for x, y in zip(target[G_TOKENS], source[G_TOKENS])),
            best_model[G_MQ],
            best_time[G_TQ],
            a,
            target[G_SIZE] + source[G_SIZE],
            first[G_OWNER],
        ]
        source[G_PARENT] = a

    for session, cands, _models in files:
        for cand in cands:
            mid, quality = cand[A_MID], cand[A_MQ]
            learned = models.get(mid)
            fallback = AGY_MODEL_IDS.get(mid) if learned is None else None
            model = (
                (cand[A_MODEL] if quality == 4 else "")
                or learned
                or fallback
                or cand[A_MODEL]
                or (f"antigravity-model-{mid}" if mid > 0 else "antigravity-unknown")
            )
            if quality != 4:
                quality = 3 if learned else 2 if fallback else quality
            i = len(groups)
            groups.append([session, cand[A_TS], model, *cand[A_UNCACHED : A_REASON + 1], quality, cand[A_TQ], i, 1, i])
            for key in cand[A_KEYS]:
                held = by_key.get(key)
                if held is not None:
                    merge(i, held)
                by_key[key] = i

    return [
        ("antigravity", g[G_TS], g[G_MODEL], g[G_SESSION], *g[G_TOKENS], None, None, 0)
        for i, g in enumerate(groups)
        if g[G_PARENT] == i
    ]


def antigravity_dirs(config: dict) -> list[Path]:
    """Every directory that holds Antigravity conversation databases."""
    home = Path.home()
    roots = [home / ".gemini" / n for n in ("antigravity", "antigravity-cli", "antigravity-ide", "antigravity-backup")]
    roots.append(home / ".config" / "antigravity")
    roots += _paths(os.environ.get("ANTIGRAVITY_DATA_DIR", "").split(","))
    roots += _paths(config.get("antigravity_data_dirs"))
    # T3 Code runs Antigravity with one profile of its own per provider instance.
    t3_home = Path(os.environ.get("T3CODE_HOME") or home / ".t3").expanduser()
    for state in ("userdata", "dev"):
        roots += sorted((t3_home / state / "providers" / "antigravity").glob("*/antigravity-acp"))
    dirs: list[Path] = []
    for root in roots:
        nested = root / "conversations"
        cand = nested if nested.is_dir() else root
        if cand.is_dir():
            real = cand.resolve()
            if real not in dirs:
                dirs.append(real)
    return dirs


def load_config() -> dict:
    """The optional JSON config. A broken file is reported and ignored, never fatal."""
    try:
        doc = json.loads(CONFIG_PATH.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        print(f"ccburn: ignoring {CONFIG_PATH}: {e}", file=sys.stderr)
        return {}
    return doc if isinstance(doc, dict) else {}


def _paths(v: object) -> list[Path]:
    items = v if isinstance(v, list) else [v] if isinstance(v, str) else []
    return [Path(p.strip()).expanduser() for p in items if isinstance(p, str) and p.strip()]


def transcript_roots(config: dict) -> list[tuple[str, Path]]:
    # Union rather than override: a shell inside one Claude install exports
    # CLAUDE_CONFIG_DIR for that install alone, and scanning only it would
    # silently drop every other install's usage. Extra installs (profiles)
    # come from the config file, which also reaches GUI launches with no
    # shell environment.
    claude_homes = [Path.home() / ".config" / "claude", Path.home() / ".claude"]
    claude_homes += _paths(config.get("claude_config_dirs"))
    claude_homes += _paths(os.environ.get("CLAUDE_CONFIG_DIR", "").split(","))
    codex_homes = [Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex").expanduser()]
    codex_homes += _paths(config.get("codex_homes"))

    roots: list[tuple[str, Path]] = []
    seen: set[Path] = set()

    def add(provider: str, cand: Path) -> None:
        if cand.is_dir():
            real = cand.resolve()
            if real not in seen:
                seen.add(real)
                roots.append((provider, real))

    for h in claude_homes:
        add("claude", h / "projects")
        add("claude", h / ".claude" / "projects")
    for h in codex_homes:
        add("codex", h / "sessions")
    return roots


def _write_atomic(path: Path, data: bytes) -> None:
    # The menu bar app and a terminal ccburn can share the cache; a reader must never see half a file.
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    try:
        tmp.write_bytes(data)
        os.replace(tmp, path)
    finally:
        if tmp.exists():
            tmp.unlink()


def collect_records(since_ms: int, verbose: bool, config: dict) -> tuple[list[tuple], dict[str, int]]:
    cache: dict = {}
    if SCAN_CACHE.exists():
        try:
            cache = pickle.loads(SCAN_CACHE.read_bytes())
        except Exception:
            cache = {}
    live: dict = {}
    records: list[tuple] = []
    stats = {"files": 0, "parsed": 0}
    cutoff = (since_ms - MTIME_SLACK_MS) / 1000
    for provider, root in transcript_roots(config):
        for dirpath, _dirs, files in os.walk(root):
            for name in files:
                if not name.endswith(".jsonl"):
                    continue
                p = Path(dirpath) / name
                try:
                    stt = p.stat()
                except OSError:
                    continue
                if stt.st_mtime < cutoff:
                    continue
                key = str(p)
                hit = cache.get(key)
                if hit and hit[0] == stt.st_size and hit[1] == stt.st_mtime_ns:
                    recs = hit[2]
                else:
                    recs = scan_file(p, provider)
                    stats["parsed"] += 1
                    if verbose and sys.stderr.isatty():
                        print(f"\r  parsing {stats['parsed']} files...", end="", file=sys.stderr, flush=True)
                live[key] = (stt.st_size, stt.st_mtime_ns, recs)
                records.extend(recs)
                stats["files"] += 1

    def stamp(p: str) -> tuple[int, int, int, float] | None:
        try:
            s = os.stat(p)
        except OSError:
            return None
        return (s.st_size, s.st_mtime_ns, s.st_ctime_ns, s.st_mtime)

    agy_files: list[tuple[str, list[tuple], dict[int, str]]] = []
    seen: set[str] = set()
    for root in antigravity_dirs(config):
        for dirpath, dirs, files in os.walk(root):
            dirs.sort()
            for name in sorted(files):
                p = Path(dirpath) / name
                if not name.endswith(".db") or p.is_symlink():
                    continue
                key = os.path.realpath(p)
                db = stamp(key)
                if db is None or key in seen:
                    continue
                seen.add(key)
                # New rows sit in the -wal file until a checkpoint, without touching the database
                # itself, and ctime moves on a write even when mtime is put back.
                wal = stamp(key + "-wal")
                if max(db[3], wal[3] if wal else 0) < cutoff:
                    continue
                mark = (db[:3], wal[:3] if wal else None)
                hit = cache.get(key)
                if hit and hit[0] == mark:
                    data = hit[2]
                else:
                    data = read_antigravity_db(Path(key), bool(wal and wal[0]), int(db[3] * 1000))
                    stats["parsed"] += 1
                    if data is None:
                        continue
                live[key] = (mark, None, data)
                agy_files.append((name[:-3], data[0], data[1]))
                stats["files"] += 1
    records.extend(merge_antigravity(agy_files))
    if verbose and stats["parsed"] and sys.stderr.isatty():
        print("\r" + " " * 40 + "\r", end="", file=sys.stderr)
    try:
        # Protocol 4 reads on every python3 the app may find (system 3.9 included).
        _write_atomic(SCAN_CACHE, pickle.dumps(live, protocol=4))
    except OSError:
        pass
    return records, stats


# -------------------------------------------------------------------- pricing


def load_rates(offline: bool, ttl_s: int = RATES_TTL_S) -> tuple[dict[str, tuple[float, float, float, float, float]], str]:
    doc = None
    status = "unavailable"
    fresh = RATES_CACHE.exists() and time.time() - RATES_CACHE.stat().st_mtime < ttl_s
    if not offline and not fresh:
        try:
            with urllib.request.urlopen(LITELLM_URL, timeout=10) as r:
                raw = r.read()
            doc = json.loads(raw)
            _write_atomic(RATES_CACHE, raw)
            status = "fresh"
        except Exception:
            doc = None
    if doc is None and RATES_CACHE.exists():
        try:
            doc = json.loads(RATES_CACHE.read_text())
            status = "cached"
        except Exception:
            doc = None
    table: dict[str, tuple[float, float, float, float, float]] = {}
    if not isinstance(doc, dict):
        return table, status
    for name, e in doc.items():
        if not isinstance(e, dict):
            continue
        inp, out = e.get("input_cost_per_token"), e.get("output_cost_per_token")
        if not isinstance(inp, (int, float)) or not isinstance(out, (int, float)):
            continue
        cr = e.get("cache_read_input_token_cost")
        cw = e.get("cache_creation_input_token_cost")
        cw1h = e.get("cache_creation_input_token_cost_above_1hr")
        cw_rate = float(cw) if isinstance(cw, (int, float)) else float(inp)
        table[name.strip().lower()] = (
            float(inp),
            float(out),
            float(cr) if isinstance(cr, (int, float)) else float(inp),
            cw_rate,
            float(cw1h) if isinstance(cw1h, (int, float)) else cw_rate,
        )
    # Alias bare names when every provider-qualified entry agrees on the rate.
    candidates: dict[str, tuple | None] = {}
    for key, rate in table.items():
        alias = key.rsplit("/", 1)[-1]
        if alias == key or alias in table:
            continue
        held = candidates.get(alias, "unset")
        if held == "unset":
            candidates[alias] = rate
        elif held is not None and held != rate:
            candidates[alias] = None
    for alias, rate in candidates.items():
        if rate is not None:
            table[alias] = rate
    return table, status


def lookup_rate(table: dict, model: str, provider: str = "") -> tuple | None:
    key = model.strip().lower().split("[", 1)[0]
    bare = key.rsplit("/", 1)[-1]
    if not bare or bare in UNPRICEABLE:
        return None
    if provider == "antigravity":
        key = antigravity_rate_model(key)
        # Resellers list some Gemini models at other prices, which leaves the bare name
        # without a rate. Antigravity is Google's own, so Google's price is the one that applies.
        if key.startswith("gemini-"):
            return table.get(f"gemini/{key}") or table.get(key)
    return table.get(key)


def missing_rates(table: dict, records: list[tuple], since_ms: int) -> set[str]:
    """Models used since since_ms that the rate table should price but does not."""
    missing: set[str] = set()
    for rec in records:
        if rec[TS] < since_ms or rec[RCOST] is not None or rec[MODEL] in missing:
            continue
        bare = rec[MODEL].strip().lower().split("[", 1)[0].rsplit("/", 1)[-1]
        if bare and bare not in UNPRICEABLE and lookup_rate(table, rec[MODEL], rec[PROV]) is None:
            missing.add(rec[MODEL])
    return missing


def retry_due() -> bool:
    """True at most once per RATES_RETRY_S, so an unknown model cannot refetch the table on every redraw."""
    try:
        if time.time() - RATES_RETRY.stat().st_mtime < RATES_RETRY_S:
            return False
    except OSError:
        pass
    try:
        _write_atomic(RATES_RETRY, b"")
    except OSError:
        pass
    return True


def price(table: dict, rec: tuple) -> tuple[float, float, bool]:
    """Returns (cost, cache_savings, unpriced)."""
    rate = lookup_rate(table, rec[MODEL], rec[PROV])
    savings = rec[CACHED] * (rate[0] - rate[2]) if rate else 0.0
    if rec[RCOST] is not None:
        return float(rec[RCOST]), savings, False
    if rate is None:
        return 0.0, 0.0, True
    cc1h = min(rec[CC1H], rec[CCREATE])
    cost = (
        rec[UNCACHED] * rate[0]
        + rec[CACHED] * rate[2]
        + (rec[CCREATE] - cc1h) * rate[3]
        + cc1h * rate[4]
        + rec[OUTPUT] * rate[1]
    )
    return cost, savings, False


# ---------------------------------------------------------------- aggregation


class Bucket:
    __slots__ = ("uncached", "cached", "ccreate", "output", "cost", "savings", "records", "unpriced", "sessions")

    def __init__(self) -> None:
        self.uncached = self.cached = self.ccreate = self.output = 0
        self.cost = self.savings = 0.0
        self.records = self.unpriced = 0
        self.sessions: set[str] = set()

    @property
    def tokens(self) -> int:
        return self.uncached + self.cached + self.ccreate + self.output

    def add(self, rec: tuple, cost: float, savings: float, unpriced: bool) -> None:
        self.uncached += rec[UNCACHED]
        self.cached += rec[CACHED]
        self.ccreate += rec[CCREATE]
        self.output += rec[OUTPUT]
        self.cost += cost
        self.savings += savings
        self.records += 1
        self.unpriced += unpriced
        if rec[SESSION]:
            self.sessions.add(rec[SESSION])


PERIOD_FMT = {"minute": "%Y-%m-%dT%H:%M", "hour": "%Y-%m-%dT%H", "day": "%Y-%m-%d"}


def dedupe(records: list[tuple]) -> list[tuple]:
    """Time-sorted records with one entry per Claude message.

    Claude Code writes one line per content block, each repeating the parent
    message's usage. Through a proxy the first of those (the thinking block)
    can carry a provisional usage with the whole prompt as uncached input and
    no cache fields, so the last line per message is the one to keep; ccusage
    lands on the same figures.
    """
    records.sort(key=lambda r: r[TS])
    unique: dict[str, tuple] = {}
    passthrough: list[tuple] = []
    for rec in records:
        if rec[DEDUPE] is None:
            passthrough.append(rec)
        else:
            unique[rec[DEDUPE]] = rec
    deduped = passthrough + list(unique.values())
    deduped.sort(key=lambda r: r[TS])
    return deduped


def aggregate(records: list[tuple], rates: dict, since_ms: int, until_ms: int, bin: str):
    by_period: dict[str, dict[str, Bucket]] = defaultdict(lambda: defaultdict(Bucket))
    by_model: dict[tuple[str, str], Bucket] = defaultdict(Bucket)
    by_provider: dict[str, Bucket] = defaultdict(Bucket)
    total = Bucket()
    for rec in dedupe(records):
        if rec[TS] < since_ms or rec[TS] >= until_ms:
            continue
        local = datetime.fromtimestamp(rec[TS] / 1000).astimezone()
        period = local.strftime(PERIOD_FMT[bin])
        cost, savings, unpriced = price(rates, rec)
        for b in (by_period[period][rec[PROV]], by_model[(rec[PROV], rec[MODEL])], by_provider[rec[PROV]], total):
            b.add(rec, cost, savings, unpriced)
    return by_period, by_model, by_provider, total


# ------------------------------------------------------------------ rendering

ANSI = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
PROVIDERS = ("claude", "codex", "antigravity")
COLOR_INDEX = {"claude": 173, "codex": 245, "antigravity": 75}
COLORS = {p: f"38;5;{n}" for p, n in COLOR_INDEX.items()}
WARN = "38;5;196"  # pure red: spend the totals are missing
ICON = {"claude": "✳", "codex": "⬡", "antigravity": "✦"}
LABEL = {"claude": "Claude Code", "codex": "Codex", "antigravity": "Antigravity"}


def c(code: str, s: str) -> str:
    return f"\x1b[{code}m{s}\x1b[0m" if ANSI else s


def dim(s: str) -> str:
    return c("2", s)


def bold(s: str) -> str:
    return c("1", s)


def fmt_usd(v: float) -> str:
    return f"${v:,.2f}"


def chart_axis(series: dict[str, list[float]], height: int) -> tuple[list[str], dict[int, str]]:
    """Stacking order (Codex under Claude, as on the T3 page) and the y-axis labels by row from the bottom."""
    order = [p for p in ("codex", "claude", "antigravity") if p in series]
    n = len(next(iter(series.values()))) if series else 0
    peak = max((sum(series[p][i] for p in order) for i in range(n)), default=0.0)
    return order, {height - 1: fmt_usd(peak), height // 2: fmt_usd(peak * (height // 2 + 1) / height), 0: "0"}


def render_chart(labels: list[str], series: dict[str, list[float]], width: int, height: int) -> list[str]:
    """Stacked bar chart in eighth-block glyphs."""
    n = len(labels)
    order, axis_labels = chart_axis(series, height)
    totals = [sum(series[p][i] for p in order) for i in range(n)]
    peak = max(totals) if totals else 0.0
    axis_w = max(len(v) for v in axis_labels.values())
    plot_w = max(1, width - axis_w - 1)
    cw = max(1, plot_w // n)
    bar_w = cw - 1 if cw >= 3 else cw
    units_per_row = 8
    scale = (height * units_per_row) / peak if peak > 0 else 0.0
    partial = " ▁▂▃▄▅▆▇█"
    rows: list[str] = []
    for row in range(height - 1, -1, -1):
        lo = row * units_per_row
        line = dim(f"{axis_labels.get(row, ''):<{axis_w}} ")
        for i in range(n):
            top = totals[i] * scale
            filled = max(0.0, min(float(units_per_row), top - lo))
            if filled <= 0:
                line += " " * cw
                continue
            # Whichever series covers the middle of the filled part owns the cell's color.
            mid = lo + filled / 2
            base = 0.0
            owner = order[-1]
            for p in order:
                nxt = base + series[p][i] * scale
                if mid < nxt:
                    owner = p
                    break
                base = nxt
            glyph = partial[int(round(filled))]
            line += c(COLORS[owner], glyph * bar_w) + " " * (cw - bar_w)
        rows.append(line)
    rows.append(dim(" " * axis_w + " " + "─" * (n * cw)))
    xl = [" "] * (n * cw)

    def put(idx: int, text: str, align_right: bool = False) -> None:
        start = idx * cw
        if align_right:
            start = start + cw - len(text)
        start = max(0, min(start, n * cw - len(text)))
        for k, ch in enumerate(text):
            if 0 <= start + k < len(xl):
                xl[start + k] = ch

    if n:
        put(0, labels[0])
        if n > 2:
            put(n // 2, labels[n // 2])
        put(n - 1, labels[-1], align_right=True)
    rows.append(dim(" " * axis_w + " " + "".join(xl)))
    return rows


def period_labels(keys: list[str]) -> list[str]:
    return [datetime.strptime(k, PERIOD_FMT["minute"]).strftime("%H:%M") for k in keys]


def render(args: argparse.Namespace) -> None:
    """Trailing-hour burn rate: per-minute cost chart plus rates over the last 5/15/60 minutes."""
    now = datetime.now().astimezone()
    minute = now.replace(second=0, microsecond=0)
    start = minute - timedelta(minutes=59)
    keys = [(start + timedelta(minutes=i)).strftime(PERIOD_FMT["minute"]) for i in range(60)]
    day_start = now.replace(hour=0, minute=0, second=0, microsecond=0)
    since_ms = int(day_start.timestamp() * 1000)
    hour_ms = int(start.timestamp() * 1000)
    until_ms = int(now.timestamp() * 1000) + 1

    t0 = time.time()
    rates, rate_status = load_rates(args.offline)
    records, stats = collect_records(since_ms, verbose=not args.watch and not args.json, config=load_config())
    # A model released after the last daily fetch has no rate yet and would count as $0
    # until the cache expires, so a miss refetches the table early.
    if not args.offline and missing_rates(rates, records, since_ms) and retry_due():
        rates, rate_status = load_rates(False, ttl_s=RATES_RETRY_S)
    by_minute, hour_by_model, hour_by_provider, _hour = aggregate(records, rates, hour_ms, until_ms, "minute")
    _, day_by_model, by_provider, today = aggregate(records, rates, since_ms, until_ms, "minute")
    scan_s = time.time() - t0

    width = args.width or shutil.get_terminal_size((120, 40)).columns
    metric = lambda b: b.cost  # noqa: E731
    fmt = fmt_usd
    unit = "/h"

    def trailing(minutes: int) -> float:
        cut = (minute - timedelta(minutes=minutes - 1)).strftime(PERIOD_FMT["minute"])
        return sum(metric(b) for k, provs in by_minute.items() if k >= cut for b in provs.values())

    # "Today" is the calendar day, so a pace projects over the hours left until midnight, not a flat 24.
    elapsed_h = (now - day_start).total_seconds() / 3600
    remaining_h = 24 - elapsed_h
    so_far = metric(today)
    day_avg = so_far / elapsed_h if elapsed_h > 0 else 0.0
    rows = [
        ("Last 5 min", trailing(5) * 12),
        ("Last 15 min", trailing(15) * 4),
        ("Last 60 min", trailing(60)),
        (f"Today's average ({elapsed_h:.1f} h)", day_avg),
    ]
    # A model with tokens but no rate stays in the table, marked, so missing spend is never silent.
    model_rows = sorted(
        ((k, b) for k, b in day_by_model.items() if metric(b) > 0 or (b.unpriced and b.tokens)),
        key=lambda kv: -metric(kv[1]),
    )

    # One column grid for every section so the dollar figures line up down the whole header.
    name_w = max([len(lab) for lab, _ in rows] + [len(m) + 2 for (_, m) in day_by_model] + [len(LABEL[p]) + 4 for p in LABEL]) + 4
    mid_w = 14
    val_w = 12
    if args.json:
        # The menu bar app draws the chart itself, with bars thinner than a character,
        # so its screen is only as wide as the tables and header and footer fit that edge.
        width = name_w + mid_w + val_w

    out: list[str] = []
    span = f"{start.strftime('%H:%M')} to {now.strftime('%H:%M')}"
    head_l = f"{bold('Burn rate')} {dim('/')} {span}"
    updated = dim("updated " + now.strftime("%H:%M:%S"))
    head_r = f"{dim('Last hour')} {dim('·')} {updated}"
    if args.json:
        if len(strip_ansi(head_l)) + 4 + len(strip_ansi(head_r)) > width:
            head_r = updated
        out.append(head_l + " " * max(4, width - len(strip_ansi(head_l)) - len(strip_ansi(head_r))) + head_r)
    else:
        out.append(head_l + "    " + head_r)
    out.append("")

    def line(name: str, mid: str, val: str) -> str:
        return f"{name:<{name_w + len(name) - len(strip_ansi(name))}}{mid:>{mid_w + len(mid) - len(strip_ansi(mid))}}{val:>{val_w + len(val) - len(strip_ansi(val))}}"

    out.append(line(dim("Pace"), dim("Rate"), dim("Today")))
    for lab, rate in rows:
        out.append(line(lab, bold(fmt(rate) + unit), fmt(so_far + rate * remaining_h)))
    out.append("")
    out.append(line(bold("Today so far"), "", fmt(so_far)))
    out.append("")
    out.append(line(dim("Provider"), dim("Last 60 min"), dim("Today")))
    for p in PROVIDERS:
        b = by_provider.get(p)
        if b is None:
            continue
        hour_p = metric(hour_by_provider.get(p, Bucket()))
        out.append(line(f"{c(COLORS[p], ICON[p])} {bold(LABEL[p])}", fmt(hour_p) + unit, fmt(metric(b))))
    out.append("")
    out.append(line(dim("Model"), dim("Last 60 min"), dim("Today")))
    for (p, m), b in model_rows:
        name = f"{c(COLORS[p], ICON[p])} {m}"
        if b.unpriced and not metric(b):
            out.append(line(name, "", c(WARN, "no rate")))
            continue
        hour_m = metric(hour_by_model.get((p, m), Bucket()))
        out.append(line(name, fmt(hour_m) + unit if hour_m else dim("idle"), fmt(metric(b))))
    out.append("")

    out.append(bold("Per-minute cost"))
    series = {p: [metric(by_minute.get(k, {}).get(p, Bucket())) for k in keys] for p in PROVIDERS if p in by_provider}
    chart_doc = None
    if not (series and any(v for s in series.values() for v in s)):
        out.append(dim("  no usage in the last hour"))
    elif args.json:
        # Blank rows hold the chart's place (plot, baseline, time labels); the app draws into them.
        order, axis_labels = chart_axis(series, args.height)
        chart_doc = {
            "row": len(out),
            "height": args.height,
            "axis_width": max(len(v) for v in axis_labels.values()),
            "axis": [{"row": r, "text": t} for r, t in sorted(axis_labels.items(), reverse=True)],
            "labels": period_labels(keys),
            "series": [{"provider": p, "color": COLOR_INDEX[p], "values": series[p]} for p in order],
        }
        out.extend([""] * (args.height + 2))
    else:
        out.extend(render_chart(period_labels(keys), series, width, args.height))
    out.append("")
    footer = f"{stats['files']} transcripts ({stats['parsed']} parsed, rest cached) · rates {rate_status} · {scan_s:.1f}s"
    if args.json and len(footer) > width:
        footer = f"{stats['files']} transcripts · rates {rate_status} · {scan_s:.1f}s"
    out.append(dim(footer))

    if args.json:
        # One frame for the menu bar app: the screen itself (ANSI colors included)
        # plus the headline numbers it shows in the menu bar.
        doc = {
            "frame": "\n".join(out),
            "width": width,
            "chart": chart_doc,
            "rate_5m": trailing(5) * 12,
            "rate_15m": trailing(15) * 4,
            "rate_60m": trailing(60),
            "today": so_far,
            "projected_today": so_far + trailing(60) * remaining_h,
            "updated": now.isoformat(timespec="seconds"),
        }
        sys.stdout.write(json.dumps(doc) + "\n")
        sys.stdout.flush()
        return
    if args.watch:
        sys.stdout.write("\x1b[H\x1b[2J")
    sys.stdout.write("\n".join(out) + "\n")
    sys.stdout.flush()


def strip_ansi(s: str) -> str:
    import re
    return re.sub(r"\x1b\[[0-9;]*m", "", s)


def main() -> None:
    ap = argparse.ArgumentParser(prog="ccburn", description=__doc__.split("\n\n")[0])
    ap.add_argument("--once", action="store_true", help="print one frame and exit instead of redrawing")
    ap.add_argument("--interval", type=int, default=60, metavar="SECONDS", help="seconds between redraws (default 60)")
    ap.add_argument("--height", type=int, default=12, help="chart height in rows")
    ap.add_argument("--offline", action="store_true", help="never fetch the LiteLLM rate table")
    ap.add_argument("--width", type=int, default=0, metavar="COLUMNS", help="screen width in columns (default: the terminal's)")
    ap.add_argument("--json", action="store_true", help="print one frame for the menu bar app as JSON (colored screen at table width, chart data, headline numbers) and exit")
    args = ap.parse_args()
    args.watch = not (args.once or args.json)
    if args.json:
        global ANSI
        ANSI = True
    if not args.watch:
        render(args)
        return
    try:
        while True:
            render(args)
            time.sleep(args.interval)
    except KeyboardInterrupt:
        print()


if __name__ == "__main__":
    main()
